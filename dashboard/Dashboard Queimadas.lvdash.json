{
  "datasets": [
    {
      "name": "f75d148e",
      "displayName": "gold_queimadas",
      "config": {
        "version": "1.1",
        "source": "proj_queimadas.gold.gold_queimadas",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "ano",
            "expr": "year(source.data_pas)"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
