	column 'Offset Ano'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d36d2e75-3419-4925-b97d-f6da024cb2f4
		summarizeBy: none
		sourceColumn: Offset Ano

	column 'Offset Mês'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9fa1652e-a23b-4762-9402-eca774f6c668
		summarizeBy: none
		sourceColumn: Offset Mês

	partition dim_calendario = m
		mode: import
		source =
				let
				    // ===== Parâmetros =====
				    Hoje         = Date.From(DateTime.LocalNow()),
				    DataInicial  = p_DataInicial,
				    DataFinal    = Date.EndOfYear(Hoje),
				    Cultura      = "pt-BR",
				
				    // ===== Função auxiliar: primeira letra maiúscula =====
				    Cap = (t as text) as text => Text.Upper(Text.Start(t, 1)) & Text.Range(t, 1),
				
				    // ===== Lista de datas =====
				    QtdDias = Duration.Days(DataFinal - DataInicial) + 1,
				    Datas   = List.Dates(DataInicial, QtdDias, #duration(1, 0, 0, 0)),
				    Tabela  = Table.FromList(Datas, Splitter.SplitByNothing(), {"Data"}, null, ExtraValues.Error),
				    Tipada  = Table.TransformColumnTypes(Tabela, {{"Data", type date}}),
				
				    // ===== Ano / Semestre / Trimestre =====
				    Ano           = Table.AddColumn(Tipada, "Ano", each Date.Year([Data]), Int64.Type),
				    SemestreNum   = Table.AddColumn(Ano, "Semestre Num", each if Date.Month([Data]) <= 6 then 1 else 2, Int64.Type),
				    Semestre      = Table.AddColumn(SemestreNum, "Semestre", each "S" & Text.From([Semestre Num]), type text),
				    TrimestreNum  = Table.AddColumn(Semestre, "Trimestre Num", each Date.QuarterOfYear([Data]), Int64.Type),
				    Trimestre     = Table.AddColumn(TrimestreNum, "Trimestre", each "T" & Text.From([Trimestre Num]), type text),
				
				    // ===== Mês =====
				    MesNum        = Table.AddColumn(Trimestre, "Mês Num", each Date.Month([Data]), Int64.Type),
				    Mes           = Table.AddColumn(MesNum, "Mês", each Cap(Date.MonthName([Data], Cultura)), type text),
				    MesAbrev      = Table.AddColumn(Mes, "Mês Abrev", each Text.Start([Mês], 3), type text),
				    AnoMesNum     = Table.AddColumn(MesAbrev, "Ano Mês Num", each [Ano] * 100 + [Mês Num], Int64.Type),
				    MesAno        = Table.AddColumn(AnoMesNum, "Mês/Ano", each [Mês Abrev] & "/" & Text.From([Ano]), type text),
				    InicioMes     = Table.AddColumn(MesAno, "Início do Mês", each Date.StartOfMonth([Data]), type date),
				    FimMes        = Table.AddColumn(InicioMes, "Fim do Mês", each Date.EndOfMonth([Data]), type date),
				
				    // ===== Dia =====
				    Dia           = Table.AddColumn(FimMes, "Dia", each Date.Day([Data]), Int64.Type),
				    DiaAno        = Table.AddColumn(Dia, "Dia do Ano", each Date.DayOfYear([Data]), Int64.Type),
				    SemanaAno     = Table.AddColumn(DiaAno, "Semana do Ano", each Date.WeekOfYear([Data], Day.Monday), Int64.Type),
				
				    // ===== Dia da semana (1 = segunda ... 7 = domingo) =====
				    DiaSemNum     = Table.AddColumn(SemanaAno, "Dia da Semana Num", each Date.DayOfWeek([Data], Day.Monday) + 1, Int64.Type),
				    DiaSem        = Table.AddColumn(DiaSemNum, "Dia da Semana", each Cap(Text.Replace(Date.DayOfWeekName([Data], Cultura), "-feira", "")), type text),
				    DiaSemAbrev   = Table.AddColumn(DiaSem, "Dia da Semana Abrev", each Text.Start([Dia da Semana], 3), type text),
				    TipoDia       = Table.AddColumn(DiaSemAbrev, "Tipo de Dia", each if [Dia da Semana Num] >= 6 then "Fim de semana" else "Dia útil", type text),
				
				    // ===== Colunas relativas (filtros dinâmicos: 0 = atual, -1 = anterior) =====
				    OffsetAno     = Table.AddColumn(TipoDia, "Offset Ano", each [Ano] - Date.Year(Hoje), Int64.Type),
				    OffsetMes     = Table.AddColumn(OffsetAno, "Offset Mês", each ([Ano] * 12 + [Mês Num]) - (Date.Year(Hoje) * 12 + Date.Month(Hoje)), Int64.Type)
				in
				    OffsetMes

