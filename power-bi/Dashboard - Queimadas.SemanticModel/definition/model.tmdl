model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["gold_queimadas","dim_hora","dim_calendario","_Medidas","dim_insights","p_DataInicial"]

ref table gold_queimadas
ref table dim_hora
ref table dim_calendario
ref table _Medidas
ref table dim_insights

ref cultureInfo pt-BR

